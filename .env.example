# Copy this file to .env.local and fill in only the values for the option
# you actually want to use. Nothing here is required for the site to build
# or run -- every integration below is inert until its variables are set.

# ---------------------------------------------------------------------------
# Contact form delivery (app/api/contact/route.ts, lib/contact-delivery.ts)
# Pick ONE option. If neither is set, the form still works end-to-end but
# inquiries are only logged locally in dev, never delivered.
# ---------------------------------------------------------------------------

# Option A: Resend (https://resend.com) -- plain HTTP API, no SDK required.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Option B: any webhook URL (Zapier, Make, n8n, a Slack/Discord incoming
# webhook, a CRM's inbound webhook, or your own endpoint). Receives a JSON
# POST: { source: "ananse-automation-website", inquiry: {...} }
# CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# AI Assistant (app/api/assistant/route.ts, lib/ai-openai.ts,
# lib/ai-knowledge.ts)
# The assistant already works without these -- it answers from the
# deterministic knowledge matcher in lib/ai-topics.ts. Setting both vars
# below switches it to real OpenAI responses; if the call ever fails, it
# falls back to the matcher rather than erroring out.
#
# AI_API_KEY is the only secret here -- this project does not also use an
# OPENAI_API_KEY variable anywhere, so there's exactly one name to set.
# ---------------------------------------------------------------------------

# AI_PROVIDER=openai
# AI_API_KEY=

# Optional -- overrides the default model (gpt-5.6-luna, OpenAI's fastest/
# most affordable current tier, chosen for a concise website assistant).
# Only needed if you want a different tier (e.g. gpt-5.6-sol) later.
# AI_MODEL=
